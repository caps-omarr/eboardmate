APP_NAME="E-BoardMate"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app-name.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Aiven for MySQL Configuration
DB_CONNECTION=mysql
DB_HOST=your-aiven-mysql-host.aivencloud.com
DB_PORT=25060
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Storage Disk Configuration (Cloudinary CDN for Permanent Uploads)
FILESYSTEM_DISK=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Queue Configuration (Sync Mode for Render Free Tier)
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Email Delivery Configuration (Brevo SMTP API)
MAIL_MAILER=brevo
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=eboardmate.system@gmail.com
MAIL_PASSWORD=your_brevo_app_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=caps.omarr@gmail.com
MAIL_FROM_NAME="E-BoardMate"
BREVO_API_KEY=your_brevo_api_key

# Public Mapbox Configuration
VITE_APP_NAME="${APP_NAME}"
VITE_MAPBOX_TOKEN=your_public_mapbox_token_here
VITE_MAP_CENTER_LAT=10.13485
VITE_MAP_CENTER_LNG=124.32274

# Google Sheets Feedback Integration Webhook
GOOGLE_SHEETS_FEEDBACK_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbxYfUaSaGBHbCobiHw4PZ02DiVF1_EpLdUHiApKZhnTnVpyBQ21oLlIe_ysm-rH9SPU/exec"
